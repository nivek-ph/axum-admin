# -----------------------------------------------------------------------------
# Logging (crate: tracing-subscriber; read by Rust at runtime)
# -----------------------------------------------------------------------------
RUST_LOG="info"
LOG_LEVEL="info"
LOG_FORMAT=compact
LOG_SPAN_EVENTS=FMT::NEW|FMT::EXIT
LOG_CONSOLE_ENABLED=true
LOG_OTEL_LOGS_ENABLED=true
LOG_SERVICE_NAME="ava"

# -----------------------------------------------------------------------------
# OpenTelemetry — see https://github.com/nivek-ph/tracing-otel-extra/blob/main/.env.example
# -----------------------------------------------------------------------------
OTEL_EXPORTER_OTLP_PROTOCOL="http/protobuf"
OTEL_EXPORTER_OTLP_ENDPOINT=
OTEL_EXPORTER_OTLP_HEADERS=

# -----------------------------------------------------------------------------
# Http server
# -----------------------------------------------------------------------------
HTTP_PORT=3000
# Public origin used in Swagger links and absolute local upload URLs.
PUBLIC_BASE_URL="http://127.0.0.1:3000"

# -----------------------------------------------------------------------------
# Database
# -----------------------------------------------------------------------------
DATABASE_URL="postgres://postgres:postgres@localhost/ava"

# -----------------------------------------------------------------------------
# Redis 8 or newer
# -----------------------------------------------------------------------------
REDIS_URL="redis://127.0.0.1:6379/"

# -----------------------------------------------------------------------------
# Authentication
# -----------------------------------------------------------------------------
JWT_SECRET="change-me"

# -----------------------------------------------------------------------------
# File storage
# -----------------------------------------------------------------------------
# Local development stores files under FILE_STORAGE_LOCAL_ROOT and serves them
# from PUBLIC_BASE_URL/uploads/...
FILE_STORAGE_DRIVER="local"
FILE_STORAGE_LOCAL_ROOT="./uploads"

# S3-compatible storage (required when FILE_STORAGE_DRIVER=s3).
# S3_PUBLIC_BASE_URL must expose the bucket publicly, optionally through a CDN
# or custom domain. S3_ROOT is appended to this URL.
# S3_BUCKET=
# S3_REGION=
# S3_ENDPOINT=
# S3_ROOT="uploads"
# S3_PUBLIC_BASE_URL=
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=
# AWS_SESSION_TOKEN=
# S3_VIRTUAL_HOST_STYLE=false

# -----------------------------------------------------------------------------
# Local audit AI (optional; defaults shown)
# -----------------------------------------------------------------------------
OLLAMA_BASE_URL="http://127.0.0.1:11434/v1"
OLLAMA_MODEL="qwen3.5:4b"

# -----------------------------------------------------------------------------
# Bootstrap admin
# -----------------------------------------------------------------------------
ADMIN_USERNAME="admin"
ADMIN_PASSWORD="123456"
ADMIN_NICKNAME="Administrator"

# -----------------------------------------------------------------------------
# Frontend (optional; copy into apps/desktop `.env`, `.env.local`, etc.)
# -----------------------------------------------------------------------------
# Overrides Axios base URL. Default when unset is http://127.0.0.1:3000/api
# VITE_API_BASE_URL="http://127.0.0.1:3000/api"
